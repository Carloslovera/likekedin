---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import profesionales from '../../data/profesionales.json';

export function getStaticPaths() {
  return profesionales.map((profesional) => ({
    params: {
      slug: profesional.id
    },
    props: {
      profesional
    }
  }));
}

const { profesional } = Astro.props;

const {
  nombre,
  cargo,
  ubicacion,
  foto,
  bio,
  skills = [],
  linkedin,
  email
} = profesional;
---

<Layout title={`${nombre} - NextByte`}>

  <Navbar />

  <main class="profile-page">

    <!-- =========================
         HEADER DEL PERFIL
    ========================== -->

    <section class="profile-header">

      <!-- Banner -->

      <div class="profile-cover">

        <span>
          FINDME! NETWORK
        </span>

      </div>


      <!-- Información -->

      <div class="profile-main">

        <div class="profile-avatar">

          <img
            src={foto}
            alt={`Foto de ${nombre}`}
          />

        </div>


        <div class="profile-information">

          <span class="profile-label">
            PROFESIONAL
          </span>

          <h1>
            {nombre}
          </h1>

          <h2>
            {cargo}
          </h2>

          <p class="location">
            {ubicacion}
          </p>

          <p class="description">
            {bio}
          </p>


          <!-- Acciones -->

          <div class="profile-actions">

            {email && (
              <a
                href={`mailto:${email}`}
                class="button primary"
              >
                Contactar
              </a>
            )}

            {linkedin && (
              <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="button secondary"
              >
                LinkedIn
              </a>
            )}

          </div>

        </div>

      </div>

    </section>


    <!-- =========================
         CONTENIDO
    ========================== -->

    <div class="profile-grid">


      <!-- SOBRE MI -->

      <section class="profile-section">

        <span class="section-label">
          PERFIL
        </span>

        <h2>
          Sobre mí
        </h2>

        <p>
          {bio}
        </p>

      </section>


      <!-- HABILIDADES -->

      <section class="profile-section">

        <span class="section-label">
          SKILLS
        </span>

        <h2>
          Habilidades
        </h2>

        <div class="skills">

          {skills.map((skill) => (

            <span class="skill">
              {skill}
            </span>

          ))}

        </div>

      </section>


      <!-- CONTACTO -->

      <section class="profile-section">

        <span class="section-label">
          CONTACTO
        </span>

        <h2>
          Información de contacto
        </h2>

        {email && (
          <a
            href={`mailto:${email}`}
            class="contact"
          >
            {email}
          </a>
        )}

      </section>


    </div>

  </main>

  <Footer />

</Layout>


<style>

  /* =========================
     PAGE
  ========================= */

  .profile-page {

    max-width: 1000px;

    margin: 0 auto;

    padding: 40px 24px 80px;

  }


  /* =========================
     HEADER
  ========================= */

  .profile-header {

    background: #111;

    border: 1px solid #292929;

    border-radius: 12px;

    overflow: hidden;

  }


  /* =========================
     COVER
  ========================= */

  .profile-cover {

    height: 180px;

    display: flex;

    align-items: flex-start;

    justify-content: flex-start;

    padding: 22px;

    background:
      linear-gradient(
        135deg,
        #242424,
        #0d0d0d
      );

    border-bottom: 1px solid #292929;

  }

  .profile-cover span {

    color: #666;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 3px;

  }


  /* =========================
     MAIN INFO
  ========================= */

  .profile-main {

    display: flex;

    gap: 28px;

    padding: 0 35px 35px;

  }


  /* =========================
     AVATAR
  ========================= */

  .profile-avatar {

    flex-shrink: 0;

    width: 130px;

    height: 130px;

    margin-top: -65px;

    border-radius: 50%;

    overflow: hidden;

    border: 5px solid #111;

    background: #222;

  }

  .profile-avatar img {

    width: 100%;

    height: 100%;

    object-fit: cover;

  }


  /* =========================
     INFORMATION
  ========================= */

  .profile-information {

    padding-top: 25px;

  }

  .profile-label {

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 2px;

    color: #666;

  }

  .profile-information h1 {

    margin-top: 7px;

    font-size: 30px;

    color: #f5f5f5;

    letter-spacing: -0.8px;

  }

  .profile-information h2 {

    margin-top: 5px;

    font-size: 15px;

    font-weight: 500;

    color: #a3a3a3;

  }

  .location {

    margin-top: 7px;

    color: #666;

    font-size: 12px;

  }

  .description {

    max-width: 650px;

    margin-top: 20px;

    color: #888;

    font-size: 13px;

    line-height: 1.7;

  }


  /* =========================
     BUTTONS
  ========================= */

  .profile-actions {

    display: flex;

    gap: 10px;

    margin-top: 22px;

  }

  .button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    height: 38px;

    padding: 0 18px;

    border-radius: 6px;

    font-size: 12px;

    font-weight: 600;

    text-decoration: none;

    transition: all 0.2s ease;

  }

  .button.primary {

    background: #f5f5f5;

    color: #080808;

  }

  .button.primary:hover {

    background: #dcdcdc;

  }

  .button.secondary {

    border: 1px solid #444;

    color: #a3a3a3;

  }

  .button.secondary:hover {

    border-color: #666;

    color: #fff;

  }


  /* =========================
     CONTENT
  ========================= */

  .profile-grid {

    display: grid;

    gap: 18px;

    margin-top: 20px;

  }

  .profile-section {

    background: #111;

    border: 1px solid #292929;

    border-radius: 12px;

    padding: 28px;

  }

  .section-label {

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 2px;

    color: #666;

  }

  .profile-section h2 {

    margin-top: 8px;

    margin-bottom: 15px;

    font-size: 20px;

    color: #f5f5f5;

  }

  .profile-section p {

    color: #888;

    font-size: 13px;

    line-height: 1.7;

  }


  /* =========================
     SKILLS
  ========================= */

  .skills {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

  }

  .skill {

    padding: 8px 12px;

    background: #1a1a1a;

    border: 1px solid #303030;

    border-radius: 6px;

    color: #aaa;

    font-size: 11px;

  }


  /* =========================
     CONTACT
  ========================= */

  .contact {

    color: #aaa;

    font-size: 13px;

    text-decoration: none;

  }

  .contact:hover {

    color: #fff;

    text-decoration: underline;

  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 700px) {

    .profile-page {

      padding-left: 16px;

      padding-right: 16px;

    }

    .profile-main {

      flex-direction: column;

      padding: 0 22px 28px;

    }

    .profile-avatar {

      margin-top: -60px;

      width: 110px;

      height: 110px;

    }

    .profile-information {

      padding-top: 0;

    }

    .profile-information h1 {

      font-size: 25px;

    }

  }

</style>