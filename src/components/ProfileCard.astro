---
interface Props {
  id: string;
  nombre: string;
  cargo: string;
  ubicacion?: string;
  foto: string;
  bio: string;
  skills?: string[];
  linkedin?: string;
  email?: string;
}

const {
  id,
  nombre,
  cargo,
  ubicacion = "España",
  foto,
  bio,
  skills = [],
  linkedin,
  email
} = Astro.props;
---

<article class="profile-card">

  <!-- Banner -->
  <div class="profile-banner">

    <span class="banner-label">
      FindMe!
    </span>

    <span class="connection-status">
      Disponible
    </span>

  </div>


  <!-- Perfil -->
  <div class="profile-content">

    <!-- Avatar -->
    <div class="avatar-container">

      <img
        src={foto}
        alt={`Foto de ${nombre}`}
        class="avatar"
      />

      <span class="online-indicator"></span>

    </div>


    <!-- Información principal -->
    <div class="profile-info">

      <a
        href={`/profesionales/${id}`}
        class="profile-name"
      >
        {nombre}
      </a>

      <p class="profile-role">
        {cargo}
      </p>

      <p class="profile-location">
        {ubicacion}
      </p>

    </div>


    <!-- Bio -->
    <p class="profile-bio">
      {bio}
    </p>


    <!-- Skills -->
    {skills.length > 0 && (

      <div class="skills">

        {skills.slice(0, 3).map((skill) => (

          <span class="skill">
            {skill}
          </span>

        ))}

        {skills.length > 3 && (

          <span class="skill more">
            +{skills.length - 3}
          </span>

        )}

      </div>

    )}


    <!-- Acciones -->
    <div class="profile-actions">

      <a
        href={`/profesionales/${id}`}
        class="view-profile"
      >
        Ver perfil
      </a>

      {linkedin && (

        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="linkedin-button"
          aria-label={`LinkedIn de ${nombre}`}
        >
          in
        </a>

      )}

    </div>

  </div>

</article>


<style>

  /* =========================
     CARD
  ========================= */

  .profile-card {

    background: #151515;

    border: 1px solid #292929;

    border-radius: 12px;

    overflow: hidden;

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;

  }

  .profile-card:hover {

    transform: translateY(-4px);

    background: #191919;

    border-color: #444;

  }


  /* =========================
     BANNER
  ========================= */

  .profile-banner {

    height: 76px;

    background:
      linear-gradient(
        135deg,
        #222 0%,
        #111 50%,
        #1c1c1c 100%
      );

    border-bottom: 1px solid #292929;

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    padding: 14px;

  }

  .banner-label {

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 2px;

    color: #737373;

  }

  .connection-status {

    font-size: 10px;

    color: #a3a3a3;

    padding: 4px 8px;

    border: 1px solid #333;

    border-radius: 20px;

    background: rgba(255,255,255,0.03);

  }


  /* =========================
     CONTENT
  ========================= */

  .profile-content {

    padding: 0 18px 18px;

  }


  /* =========================
     AVATAR
  ========================= */

  .avatar-container {

    position: relative;

    width: 72px;
    height: 72px;

    margin-top: -36px;

    margin-bottom: 12px;

  }

  .avatar {

    width: 72px;
    height: 72px;

    object-fit: cover;

    border-radius: 50%;

    border: 4px solid #151515;

    background: #222;

  }

  .online-indicator {

    position: absolute;

    bottom: 5px;
    right: 4px;

    width: 13px;
    height: 13px;

    border-radius: 50%;

    background: #999;

    border: 3px solid #151515;

  }


  /* =========================
     INFO
  ========================= */

  .profile-name {

    display: block;

    color: #f5f5f5;

    font-size: 17px;

    font-weight: 700;

    line-height: 1.3;

    text-decoration: none;

    margin-bottom: 4px;

  }

  .profile-name:hover {

    color: #fff;

    text-decoration: underline;

  }

  .profile-role {

    color: #a3a3a3;

    font-size: 13px;

    margin: 0;

  }

  .profile-location {

    color: #666;

    font-size: 11px;

    margin-top: 5px;

  }


  /* =========================
     BIO
  ========================= */

  .profile-bio {

    color: #858585;

    font-size: 12px;

    line-height: 1.6;

    margin-top: 14px;

    display: -webkit-box;

    -webkit-line-clamp: 2;

    -webkit-box-orient: vertical;

    overflow: hidden;

  }


  /* =========================
     SKILLS
  ========================= */

  .skills {

    display: flex;

    flex-wrap: wrap;

    gap: 6px;

    margin-top: 14px;

  }

  .skill {

    color: #b5b5b5;

    background: #202020;

    border: 1px solid #303030;

    padding: 5px 9px;

    border-radius: 5px;

    font-size: 10px;

  }

  .skill.more {

    color: #666;

  }


  /* =========================
     ACTIONS
  ========================= */

  .profile-actions {

    display: flex;

    gap: 8px;

    margin-top: 18px;

    padding-top: 14px;

    border-top: 1px solid #292929;

  }

  .view-profile {

    flex: 1;

    display: flex;

    justify-content: center;

    align-items: center;

    height: 34px;

    border: 1px solid #555;

    border-radius: 6px;

    color: #f5f5f5;

    text-decoration: none;

    font-size: 12px;

    font-weight: 600;

    transition: all 0.2s ease;

  }

  .view-profile:hover {

    background: #f5f5f5;

    color: #080808;

    border-color: #f5f5f5;

  }

  .linkedin-button {

    width: 36px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid #333;

    border-radius: 6px;

    color: #888;

    text-decoration: none;

    font-size: 13px;

    font-weight: 800;

    transition: all 0.2s ease;

  }

  .linkedin-button:hover {

    color: #fff;

    border-color: #666;

    background: #222;

  }

</style>